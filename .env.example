# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend — resend.com)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=bookings@teyezillaexpeditions.com   # PLACEHOLDER — update before launch
EMAIL_FROM=Teyezilla Expeditions <noreply@teyezillaexpeditions.com>   # PLACEHOLDER domain — must be a Resend-verified domain

# Error monitoring (Sentry — sentry.io). SENTRY_DSN and
# NEXT_PUBLIC_SENTRY_DSN are the same value (server + client need their own
# env var name); the other three are only needed to upload source maps at
# build time and can stay empty until that's set up.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Rate limiting on public forms (Upstash Redis — upstash.com, free tier is
# enough at this traffic level). Optional: fails open (allows submissions
# unthrottled) if left empty, same as the email vars above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp Business Cloud API (Phase 4)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# Google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # Phase 4, not yet wired into any code path
NEXT_PUBLIC_GA_MEASUREMENT_ID=     # GA4 measurement ID, e.g. G-XXXXXXX -- <GoogleAnalytics> is commented out in app/layout.tsx until this is set and the domain is connected
NEXT_PUBLIC_GTM_ID=                # Phase 4, not yet wired into any code path

# Microsoft Clarity (clarity.microsoft.com) -- heatmaps/session recordings.
# Free. The project ID from Clarity's setup page; script is loaded in
# app/layout.tsx only when this is set.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
